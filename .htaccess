# SPA fallback routing untuk Hostinger (Apache / LiteSpeed)
# Semua permintaan yang bukan file/folder fisika diarahkan ke index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
